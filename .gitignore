# macOS
.DS_Store

# dependencies (na úrovni podprojektov)
**/node_modules/

# next.js build
**/.next/
**/out/

# logs
*.log
npm-debug.log*

# env
.env
.env*.local

# vercel
.vercel

# private (neverejné – nekomituje sa)
/private/

# TypeScript inkrementalny build cache
*.tsbuildinfo

# Python virtualenv a cache
.venv/
venv/
__pycache__/
*.pyc

# docasna sprava commitu (pisana kvoli diakritike do suboru, commit cez git commit -F)
.commit_msg.tmp
