# macOS
.DS_Store

# dependencies (na úrovni podprojektov)
**/node_modules/

# next.js build
**/.next/
**/out/
# Generuje ho Next pri každom `dev` aj `build` a dev server doň píše iné
# cesty (`.next/dev/types`) než build — v gite len blokoval `git pull`.
**/next-env.d.ts

# logs
*.log
npm-debug.log*

# env
.env
.env*.local

# vercel
.vercel

# private (neverejné – nekomituje sa)
/private/

# TypeScript inkrementalny build cache
*.tsbuildinfo

# Python virtualenv a cache
.venv/
venv/
__pycache__/
*.pyc

# docasna sprava commitu (pisana kvoli diakritike do suboru, commit cez git commit -F)
.commit_msg.tmp
