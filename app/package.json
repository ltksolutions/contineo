{
  "name": "contineo-app",
  "version": "0.1.0",
  "private": true,
  "description": "Contineo — inteligentný RAG helpdesk a CMS platforma",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "persons:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=DEP0205 --import ./scripts/lib/ts-hook.mjs scripts/import_persons.mjs",
    "ack:report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=DEP0205 --import ./scripts/lib/ts-hook.mjs scripts/acknowledgement_report.mjs",
    "seed:test": "node scripts/seed_test_onboarding.mjs",
    "stav": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=DEP0205 --import ./scripts/lib/ts-hook.mjs scripts/stav.mjs",
    "domeny": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=DEP0205 --import ./scripts/lib/ts-hook.mjs scripts/domeny.mjs",
    "admin": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=DEP0205 scripts/admin_set.mjs",
    "osoba": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=DEP0205 scripts/osoba.mjs",
    "tenant": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=DEP0205 --import ./scripts/lib/ts-hook.mjs scripts/tenant_set.mjs",
    "verzie": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=DEP0205 --import ./scripts/lib/ts-hook.mjs scripts/verzie_z_chunkov.mjs",
    "platnost": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/platnost.mjs",
    "utvary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/utvary_z_textu.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "mammoth": "^1.12.2",
    "mongodb": "^6.7.0",
    "next": "^16.3.3",
    "next-auth": "^4.24.15",
    "pdfjs-dist": "^6.3.289",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turndown": "^7.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
